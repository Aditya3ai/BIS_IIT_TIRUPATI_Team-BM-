# Environment variables for BIS Standard Recommendation Engine
# Copy this to .env and fill in your keys

# Google Gemini API (optional - for rationale generation)
GOOGLE_API_KEY=AIzaSyCT1nxTbsRH9u2tRtMpiAukt-4JULFhioQ

# Hugging Face Token (optional - for downloading embedding models)
