# Example environment variables for local development
# Copy this file to `.env` and update values as needed. Do NOT commit `.env`.

# Optional: Google Gemini / Google API Key for rationale generation (optional)
GOOGLE_API_KEY=""

# Optional: Hugging Face token for model downloads
HF_TOKEN=""

# Optional Local LLM settings (use instead of Google API)
USE_LOCAL_LLM=false
LOCAL_LLM_MODEL=llama-2-7b-chat
LOCAL_LLM_DEVICE=cpu

# Retrieval toggles
USE_VECTOR_SEARCH=true
USE_BM25=true

# Debugging
LOG_LEVEL=INFO
